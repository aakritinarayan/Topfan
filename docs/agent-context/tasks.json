        "cta": "Show me the domain choice",
        "target": "pref-outbound-setup-continue",
        "completionCheck": "(c) => c.now.outboundPhase === \"records\" || c.now.outbound === \"pending\" || c.now.outbound === \"verified\""
      },
      {
        "id": "records",
        "title": "Add the records at your domain provider, then tick that you've added them",
        "routeId": "pref-outbound-emails",
        "cta": "Show the records",
        "hint": "Copy each Host and Value into your provider's DNS settings. I can't change DNS for you.",
        "target": "pref-outbound-records-added",
        "approval": "protected",
        "completionCheck": "(c) => c.now.outboundRecordsAdded || c.now.outbound === \"pending\" || c.now.outbound === \"verified\""
      },
      {
        "id": "verify",
        "title": "Click Verify Outbound Email Settings",
        "routeId": "pref-outbound-emails",
        "cta": "Go to Verify",
        "target": "pref-outbound-verify",
        "completionCheck": "(c) => c.now.outbound === \"pending\" || c.now.outbound === \"verified\""
      },
